local function irAlPuntoSeguro()

	local character =
		obtenerPersonaje()

	if character then

		character:PivotTo(
			CFrame.new(
				TELEPORT_POSITION
			)
		)

	end

	objetivo = nil
	teleportOffset = false

	if esGuardOMTF() then
		cambiarColision(true)
	end

end

