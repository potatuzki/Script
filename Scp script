local function actualizarJugador(jugador)

	local function actualizarCharacter(
		character
	)

		local head =
			character:WaitForChild(
				"Head",
				5
			)

		if not head then
			return
		end

		local antiguo =
			head:FindFirstChild(
				"EquipoDisplay"
			)

		if antiguo then
			antiguo:Destroy()
		end

		local billboard =
			Instance.new(
				"BillboardGui"
			)

		billboard.Name =
			"EquipoDisplay"

		billboard.Parent =
			head

		billboard.Size =
			UDim2.new(
				0,200,
				0,40
			)

		billboard.StudsOffset =
			Vector3.new(0,3,0)

		billboard.AlwaysOnTop =
			true

		billboard.Enabled =
			teamNameEnabled

		local label =
			Instance.new(
				"TextLabel"
			)

		label.Parent =
			billboard

		label.Size =
			UDim2.new(1,0,1,0)

		label.BackgroundTransparency =
			1

		label.TextScaled =
			true

		label.Font =
			Enum.Font.SourceSansBold

		label.TextStrokeTransparency =
			0

		if jugador.Team then

			label.Text =
				jugador.Team.Name

			label.TextColor3 =
				jugador.Team.TeamColor.Color

		else

			label.Text =
				"SIN EQUIPO"

			label.TextColor3 =
				Color3.fromRGB(
					255,255,255
				)

		end

		local oldHighlight =
			character:FindFirstChild(
				"EquipoHighlight"
			)

		if oldHighlight then
			oldHighlight:Destroy()
		end

		local teamHighlight =
			Instance.new(
				"Highlight"
			)

		teamHighlight.Name =
			"EquipoHighlight"

		if jugador.Team then

			teamHighlight.FillColor =
				jugador.Team.TeamColor.Color

			teamHighlight.OutlineColor =
				jugador.Team.TeamColor.Color

		else

			teamHighlight.FillColor =
				Color3.fromRGB(
					255,255,255
				)

			teamHighlight.OutlineColor =
				Color3.fromRGB(
					255,255,255
				)

		end

		teamHighlight.FillTransparency =
			0.65

		teamHighlight.OutlineTransparency =
			0

		teamHighlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		teamHighlight.Parent =
			character

	end

	if jugador.Character then

		task.spawn(
			actualizarCharacter,
			jugador.Character
		)

	end

	jugador.CharacterAdded:Connect(
		function(character)

			actualizarCharacter(
				character
			)

		end
	)

	jugador:GetPropertyChangedSignal(
		"Team"
	):Connect(function()

		if jugador.Character then

			actualizarCharacter(
				jugador.Character
			)

		end

	end)

end

for _,jugador in pairs(
	game.Players:GetPlayers()
) do

	actualizarJugador(
