--------------------------------------------------
-- LOOP TELETRANSPORTE
--------------------------------------------------

runService.Heartbeat:Connect(
	function(deltaTime)

		if not activo then
			return
		end

		local character =
			obtenerPersonaje()

		local humanoid =
			obtenerHumanoid()

		local root =
			obtenerRoot(
				character
			)

		if not character
		or not humanoid
		or not root then

			return

		end

		local guardOMTF =
			esGuardOMTF()

		-- Mantener sin colisión
		if guardOMTF then
			cambiarColision(false)
		end

		if humanoid.Health <= 0 then
			return
		end

		if humanoid.MaxHealth > 0
		and humanoid.Health /
			humanoid.MaxHealth
			< HEALTH_PERCENT then

			irAlPuntoSeguro()
			return

		end

		if not objetivo then

			objetivo =
				buscarEnemigo()

			if not objetivo then

				irAlPuntoSeguro()
				return

			end

		end

		local objetivoCharacter =
			objetivo.Character

		local objetivoHumanoid =
			objetivoCharacter
			and objetivoCharacter:
				FindFirstChildOfClass(
					"Humanoid"
				)

		local objetivoRoot =
			obtenerRoot(
				objetivoCharacter
			)

		local objetivoValido = true

		if not objetivoCharacter
		or not objetivoHumanoid
		or objetivoHumanoid.Health <= 0
		or not objetivoRoot then

			objetivoValido = false

		end

		if guardOMTF then

			if not objetivo.Team
			or objetivo.Team.Name ~= "SCP" then

				objetivoValido = false

			end

		else

			if objetivo.Team ==
				player.Team then

				objetivoValido = false

			end

		end

		if not objetivoValido then

			objetivo =
				buscarEnemigo()

			if not objetivo then
				irAlPuntoSeguro()
			end

			return

		end

		tiempo += deltaTime

		if tiempo >= INTERVALO then

			tiempo = 0

			root.AssemblyLinearVelocity =
				Vector3.zero

			root.AssemblyAngularVelocity =
				Vector3.zero

			if guardOMTF then

				--------------------------------------------------
				-- GUARD / MTF
				-- ALTURA EDITABLE SOBRE EL SCP
				--------------------------------------------------

				local head =
					objetivoCharacter:
						FindFirstChild(
							"Head"
						)

				if head then

					local posicion =
						head.Position
						+ Vector3.new(
							0,
							altura,
							0
						)

					root.CFrame =
						CFrame.new(
							posicion
						)
						* CFrame.Angles(
							math.rad(-90),
							0,
							0
						)

				end

			else

				--------------------------------------------------
				-- OTROS EQUIPOS
				-- 0 -> 3 -> 0 -> 3
				--------------------------------------------------

				teleportOffset =
					not teleportOffset

				if teleportOffset then

					root.CFrame =
						objetivoRoot.CFrame
						* CFrame.new(
							0,0,3
						)

				else

					root.CFrame =
						objetivoRoot.CFrame

				end

			end

		end

	end
)

--------------------------------------------------
-- CAMLOCK
--------------------------------------------------

local function alive(char)

	local hum =
		char:FindFirstChild(
			"Humanoid"
		)

	return hum
		and hum.Health > 0

end

--------------------------------------------------
-- REGLA MTF / GUARD
--------------------------------------------------

local function shouldIgnoreTarget(v)

	if player.Team
	and (
		player.Team.Name == "MTF"
		or player.Team.Name == "Guard"
	) then

		if v.Team
		and (
			v.Team.Name == "MTF"
			or v.Team.Name == "Guard"
		) then

			return true

		end

	end

	return false

end

--------------------------------------------------
-- WALL CHECK
--------------------------------------------------

local function wallCheck(part)

	local origin =
		camera.CFrame.Position

	local direction =
		part.Position - origin

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Blacklist

	params.FilterDescendantsInstances =
		{player.Character}

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	if result then

		return result.Instance:
			IsDescendantOf(
				part.Parent
			)

	end

	return true

end

--------------------------------------------------
-- OBJETIVO CERCA
--------------------------------------------------

local function getCloseTarget()

	local myChar =
		player.Character

	if not myChar
	or not myChar:FindFirstChild(
		"HumanoidRootPart"
	) then

		return nil

	end

	local myPos =
		myChar.HumanoidRootPart.Position

	local closest = nil
	local dist = closeDistance

	for _,v in pairs(
		game.Players:GetPlayers()
	) do

		if v ~= player
		and not shouldIgnoreTarget(v)
		and (
			not teamCheck
			or v.Team ~= player.Team
		) then

			if v.Character
			and v.Character:FindFirstChild(
				"HumanoidRootPart"
			)
			and v.Character:FindFirstChild(
				"Head"
			)
			and alive(v.Character)
			and wallCheck(
				v.Character.Head
			) then

				local mag =
					(
						v.Character:
							FindFirstChild(
								"HumanoidRootPart"
							).Position
						- myPos
					).Magnitude

				if mag < dist then

					dist = mag
					closest = v

				end

			end

		end

	end

	return closest

end

--------------------------------------------------
-- OBJETIVO FOV
--------------------------------------------------

local function getClosest()

	local closest = nil
	local dist = fov

	for _,v in pairs(
		game.Players:GetPlayers()
	) do

		if v ~= player
		and not shouldIgnoreTarget(v)
		and (
			not teamCheck
			or v.Team ~= player.Team
		) then

			if v.Character
			and v.Character:FindFirstChild(
				"HumanoidRootPart"
			)
			and v.Character:FindFirstChild(
				"Head"
			)
			and alive(v.Character)
			and wallCheck(
				v.Character.Head
			) then

				local pos,visible =
					camera:WorldToViewportPoint(
						v.Character.Head.Position
					)

				if visible then

					local mag =
						(
							Vector2.new(
								pos.X,
								pos.Y
							)
							-
							Vector2.new(
								camera.ViewportSize.X / 2,
								camera.ViewportSize.Y / 2
							)
						).Magnitude

					if mag < dist then

						dist = mag
						closest = v

					end

				end

			end

		end

	end

	return closest

end

--------------------------------------------------
-- LOOP CAMLOCK
--------------------------------------------------

runService.RenderStepped:Connect(
	function()

		if not camlockEnabled then

			highlight.Adornee = nil
			return

		end

		local target =
			getCloseTarget()

		local aimStrength = 0.35

		if target then

			fovFrame.Visible = false
			aimStrength = 0.8

		else

			target =
				getClosest()

			fovFrame.Visible = true

		end

		if target
		and target.Character
		and alive(
			target.Character
		) then

			local head =
				target.Character.Head

			local new =
				CFrame.new(
					camera.CFrame.Position,
					head.Position
				)

			camera.CFrame =
				camera.CFrame:Lerp(
					new,
					aimStrength
				)

			highlight.Adornee =
				target.Character

		else

			highlight.Adornee = nil

		end

	end
)
