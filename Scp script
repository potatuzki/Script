--------------------------------------------------
-- FUNCIONES TELETRANSPORTE
--------------------------------------------------

local function obtenerPersonaje()
	return player.Character
end

local function obtenerHumanoid()

	local character =
		obtenerPersonaje()

	if character then
		return character:FindFirstChildOfClass("Humanoid")
	end

	return nil

end

local function obtenerRoot(character)

	if character then
		return character:FindFirstChild("HumanoidRootPart")
	end

	return nil

end

--------------------------------------------------
-- COLISION
--------------------------------------------------

local function esGuardOMTF()

	return player.Team
		and (
			player.Team.Name == "Guard"
			or player.Team.Name == "MTF"
		)

end

local function cambiarColision(estado)

	local character =
		player.Character

	if not character then
		return
	end

	for _,obj in pairs(
		character:GetDescendants()
	) do

		if obj:IsA("BasePart") then
			obj.CanCollide = estado
		end

	end

end

--------------------------------------------------
-- BUSCAR OBJETIVO
--------------------------------------------------

local function buscarEnemigo()

	local enemigos = {}
	local guardOMTF =
		esGuardOMTF()

	for _,jugador in pairs(
		game.Players:GetPlayers()
	) do

		if jugador ~= player then

			local esObjetivo = false

			if guardOMTF then

				if jugador.Team
				and jugador.Team.Name == "SCP" then

					esObjetivo = true

				end

			else

				if jugador.Team ~= nil
				and jugador.Team ~= player.Team then

					esObjetivo = true

				end

			end

			if esObjetivo then

				local character =
					jugador.Character

				local humanoid =
					character
					and character:FindFirstChildOfClass(
						"Humanoid"
					)

				local root =
					obtenerRoot(character)

				if humanoid
				and humanoid.Health > 0
				and root then

					table.insert(
						enemigos,
						jugador
					)

				end

			end

		end

	end

	if #enemigos > 0 then

		return enemigos[
			math.random(
				1,
				#enemigos
			)
		]

	end

	return nil

end

